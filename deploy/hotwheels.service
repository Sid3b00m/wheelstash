[Unit]
Description=Hot Wheels collection tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hotwheels
Group=hotwheels
WorkingDirectory=/opt/hotwheels-tracker
EnvironmentFile=-/etc/hotwheels-tracker.env
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=3000
Environment=DATA_DIR=/opt/hotwheels-tracker/storage
# Node may be /usr/bin/node or /usr/local/bin/node depending on how you installed it.
ExecStart=/usr/bin/env node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
