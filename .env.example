# Copy to .env and adjust. The app also reads these from the process environment.
# Docker Compose automatically loads .env for ${VAR} substitutions.

# Bind address and port. HOST=0.0.0.0 makes the app reachable on your LAN.
HOST=0.0.0.0
PORT=3000

# Where the database, rarity list, hunt cache, and photos are stored.
# In Docker this is the path *inside* the container; bind-mount your host folder to it.
DATA_DIR=./storage

# Timezone for the weekly refresh cron. Examples: UTC, America/Chicago, Europe/London
TZ=UTC

# Weekly hunt/rarity refresh. Cron is standard 5-field syntax.
REFRESH_ENABLED=true
REFRESH_CRON=0 6 * * 1
# Optional local Ollama vision model for "Identify with AI".
# Leave OLLAMA_URL empty to disable AI. Do not expose Ollama to the public internet.
# Examples: http://127.0.0.1:11434   http://ollama:11434   http://your-ollama-host:11434
OLLAMA_URL=
OLLAMA_VISION_MODEL=qwen2.5vl:7b
AI_SCAN_ENABLED=true
AI_SCAN_TIMEOUT_MS=90000

# Name given to the first collector tab if the database is empty.
DEFAULT_USER_NAME=Collector
